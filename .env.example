# Copy this file to .env and fill in real values. Never commit .env.
#
# No secret in this file may ever carry a NEXT_PUBLIC_ prefix — that prefix tells Next.js to
# inline the value into the client JS bundle. The only NEXT_PUBLIC_ variable below
# (NEXT_PUBLIC_SITE_URL) is the site's own public URL, not a secret. CLAUDE.md §3.3 / §10.
#
# Note that even the Supabase *publishable* key below has no NEXT_PUBLIC_ prefix: this app builds
# no Supabase client in the browser at all (every auth flow is a server action and the session is
# an httpOnly cookie), so it never needs to be inlined. See lib/supabase/config.ts.

# --- Database (Supabase Postgres via Drizzle) --------------------------------------------------
# Supabase is plain Postgres, so the app connects with the `pg` driver directly.
#
# DATABASE_URL is what the running app uses. In a deployed environment this should be the Supavisor
# *transaction* pooler (port 6543) — serverless functions open far more short-lived connections
# than Postgres can hold, and transaction-mode pooling is what Supabase provides for that. It still
# supports real transactions (it pins a backend for the duration of one), which checkout's
# stock/coupon/order-insert atomicity requires (CLAUDE.md §7.5).
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# DIRECT_DATABASE_URL is the direct/session connection (port 5432). drizzle-kit uses it for
# migrations, because DDL and its advisory locks need a session that outlives one transaction.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# For local development, `supabase start` gives you one direct connection that serves as both —
# see README.md's "Local Supabase stack" section:
#   postgresql://postgres:postgres@127.0.0.1:54422/postgres
DATABASE_URL=
DIRECT_DATABASE_URL=
# Optional. Max connections in the app's own pool, per instance. Kept small by default (5) because
# every serverless instance gets its own pool. Raise it only for a long-lived single process
# (PM2 + Nginx on a VPS).
DATABASE_POOL_MAX=

# --- Supabase Auth ------------------------------------------------------------------------------
# The project's API origin: https://<project-ref>.supabase.co in a deploy, http://127.0.0.1:54421
# locally (`supabase status` prints it).
SUPABASE_URL=
# The publishable (formerly "anon") key. Safe to hold server-side; protected by RLS, not secrecy.
SUPABASE_PUBLISHABLE_KEY=
# The secret (formerly "service_role") key. Bypasses RLS and can create/delete auth users — used
# only by admin server actions behind requireStaffOrAdmin(), by scripts/create-staff-user.ts, and
# by the NODE_ENV-gated test-token route. Never expose it to a client.
SUPABASE_SECRET_KEY=
#
# DEPLOY CHECKLIST — one thing lives in Supabase's own settings, not in this file:
#  - Auth → URL Configuration: set the Site URL and add <site>/auth/confirm to the allowed
#    redirect URLs, or the confirmation and password-reset links will refuse to redirect.
#
# No auth hook is needed. middleware.ts reads the role from public.users directly, so there is
# nothing to enable in the dashboard for /admin to work.

# --- Supabase Storage (S3-compatible protocol) --------------------------------------------------
# Product, review, post, brand and banner images. Spoken to over Supabase's S3 gateway so the
# presigned-upload + sharp-derivative pipeline is the real thing (lib/storage/storage-core.ts).
#
# Create the bucket (named below) as a PUBLIC bucket, then create an S3 access key pair under
# Storage → S3 Access Keys.
#   STORAGE_ENDPOINT        https://<project-ref>.supabase.co/storage/v1/s3
#   STORAGE_REGION          the project's region, e.g. ap-south-1  ("local" for the local stack)
#   STORAGE_PUBLIC_BASE_URL https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_BASE_URL=

# --- Order-link signing --------------------------------------------------------------------------
# HMAC secret for the signed guest order-confirmation links (lib/order-token.ts). Nothing to do
# with Supabase Auth — it is this app's own link-signing key, and was called AUTH_SECRET back when
# Auth.js owned that name. Generate with: openssl rand -base64 32
ORDER_LINK_SECRET=

# --- Resend (transactional email) ---------------------------------------------------------------
# Resend API key (Resend dashboard → API Keys). Sends the order/shipping mail this app composes
# itself. Supabase Auth sends its own confirmation/recovery mail separately — point that at a real
# SMTP provider under Auth → Emails for production, or its default sender will rate-limit hard.
RESEND_API_KEY=
# The verified "from" address/name transactional email is sent from, e.g. "Dishu Masala <orders@dishumasala.com>"
EMAIL_FROM=

# --- Razorpay (payments: UPI, cards, netbanking, wallets) ----------------------------------------
# Public-looking but still server-side — used to create Razorpay orders, never exposed to the client.
RAZORPAY_KEY_ID=
# Razorpay secret key — used to create orders server-side and verify payment signatures.
RAZORPAY_KEY_SECRET=
# Separate secret configured in the Razorpay dashboard for verifying incoming webhook signatures.
RAZORPAY_WEBHOOK_SECRET=

# --- Shiprocket (pincode serviceability, order push, tracking) -----------------------------------
# Shiprocket account email used to obtain an auth token.
SHIPROCKET_EMAIL=
# Shiprocket account password used to obtain an auth token.
SHIPROCKET_PASSWORD=

# --- Public ---------------------------------------------------------------------------------------
# The site's own public origin, safe to inline into the client bundle (not a secret), e.g.
# https://dishumasala.com in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Meta (Facebook) Pixel ID, from Events Manager. Not a secret — it's visible in every page's own
# source once the pixel loads (components/marketing/MetaPixel.tsx). Leave unset to disable the
# pixel entirely (no script, no fbq calls, no noscript beacon).
NEXT_PUBLIC_META_PIXEL_ID=
